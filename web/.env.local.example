# 複製成 .env.local 後填入（Supabase 後台 → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# 新專案叫 Publishable key（sb_publishable_…）；舊專案的 anon key 也可以
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# AI 記帳（說一句、拍收據）：Google AI Studio 建立的 API key。只在伺服器使用，不要加 NEXT_PUBLIC_
GEMINI_API_KEY=
# 選填：換模型（逗號分隔，依序嘗試）
# GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# 匯出到 Google Sheets、Google 雲端同步：Google Cloud 建立的 OAuth 用戶端 ID（網頁應用程式）。用戶端 ID 本來就是公開的，可以加 NEXT_PUBLIC_
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google 雲端同步（收據、年度帳本）：只在伺服器使用，兩個都不要加 NEXT_PUBLIC_
# 同一個 OAuth 用戶端的用戶端密碼
GOOGLE_CLIENT_SECRET=
# 加密 Google 授權的金鑰（32 bytes 的 base64）：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 設定後不要再換，換了要重新連結
GOOGLE_TOKEN_KEY=
